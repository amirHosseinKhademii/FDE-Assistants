{
  "name": "@claims/insurance",
  "version": "0.0.1",
  "private": true,
  "description": "Claims coverage assistant \u2014 grounding, tools, schema, evals, telemetry. No HTTP, no React.",
  "license": "UNLICENSED",
  "main": "./dist/tools/loop.factory.js",
  "exports": {
    ".": "./dist/coverage.js",
    "./loop": "./dist/tools/loop.factory.js",
    "./prompt": "./dist/tools/coverage-prompt.js",
    "./schema": "./dist/schema/coverage-schema.js",
    "./client": "./dist/foundry/client.js",
    "./registry": "./dist/tools/registry.js",
    "./tools/policyholder": "./dist/tools/get-policyholder.tool.js",
    "./tools/search": "./dist/tools/search-policy.tool.js",
    "./grounding": "./dist/grounding/store.js",
    "./embeddings": "./dist/grounding/embeddings.factory.js",
    "./telemetry": "./dist/telemetry/request-log.js",
    "./config": "./dist/config/domain.js",
    "./directory": "./dist/directory.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ask": "ts-node src/ask.ts",
    "eval": "ts-node src/eval/run.ts",
    "eval:smoke": "ts-node src/eval/run.ts --repeat 1",
    "eval:diff": "ts-node src/eval/diff.ts",
    "eval:history": "ts-node src/eval/history.ts",
    "chunks": "ts-node src/grounding/cli.ts chunks",
    "holder": "ts-node src/grounding/cli.ts holder",
    "ingest": "ts-node src/grounding/cli.ts ingest",
    "query": "ts-node src/grounding/cli.ts query",
    "env:check": "ts-node src/grounding/cli.ts config",
    "schema:check": "ts-node src/schema/schema-selftest.ts",
    "compliance:check": "ts-node src/schema/compliance-selftest.ts",
    "compliance:mastra": "ts-node src/schema/compliance-mastra-selftest.ts",
    "severity:check": "ts-node src/eval/scorecard-selftest.ts",
    "logs:sync": "ts-node src/telemetry/logs-sync.ts",
    "corpus": "node scripts/generate-corpus.mjs",
    "guard:check": "ts-node ../../../packages/guard/src/selftest.ts",
    "corpus:load": "ts-node src/grounding/cli.ts corpus:load",
    "corpus:check": "ts-node src/grounding/cli.ts corpus:check"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.47",
    "@azure/identity": "^4.5.0",
    "@langchain/classic": "^1.0.46",
    "@langchain/core": "^1.2.9",
    "@langchain/openai": "^1.5.11",
    "@langchain/pgvector": "^0.1.0",
    "@langchain/textsplitters": "^1.0.1",
    "@langfuse/client": "^5.11.0",
    "@langfuse/otel": "^5.11.0",
    "@langfuse/tracing": "^5.11.0",
    "@mastra/core": "^1.66.0",
    "@openai/agents": "^0.17.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "ai": "^7.0.97",
    "dotenv": "^16.4.5",
    "markdown-it": "^15.0.1",
    "openai": "^7.10.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4",
    "@fde/grounding": "workspace:*",
    "@fde/evals": "workspace:*",
    "@fde/schema": "workspace:*",
    "@fde/agent": "workspace:*",
    "@fde/telemetry": "workspace:*",
    "@fde/foundry": "workspace:*",
    "@fde/guard": "workspace:*"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.10.12",
    "typescript": "^5.1.3"
  },
  "files": [
    "dist",
    "examples",
    "package.json"
  ],
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
