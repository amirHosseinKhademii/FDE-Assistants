{
  "name": "@meridian/pharma",
  "version": "0.0.1",
  "private": true,
  "description": "Meridian Pharma \u2014 the second domain. Step 1: six sibling databases and the data that ties them together. See docs/PHARMA-PLAN.md.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:create": "ts-node src/db/init/create.ts",
    "db:migrate": "ts-node src/db/init/migrate.ts",
    "db:seed": "ts-node src/db/seed/seed.ts",
    "db:check": "ts-node src/db/init/check.ts",
    "estate": "ts-node src/db/init/inventory.ts",
    "db:trace": "ts-node src/cli/lot-trace.ts",
    "db:release": "ts-node src/cli/release-report.ts",
    "db:supplier-impact": "ts-node src/cli/supplier-impact.ts",
    "compliance:check": "ts-node src/guard/compliance-selftest.ts",
    "compliance:mastra": "ts-node src/guard/compliance-mastra-selftest.ts",
    "compliance:langgraph": "ts-node src/guard/compliance-langgraph-selftest.ts",
    "sql:check": "ts-node src/guard/sql-write-selftest.ts",
    "schema:check": "ts-node src/schema/release-selftest.ts",
    "supplier-schema:check": "ts-node src/schema/supplier-impact-selftest.ts",
    "eval": "ts-node src/eval/run.ts",
    "supplier-eval": "ts-node src/eval/run-supplier-impact.ts",
    "supplier-eval:smoke": "ts-node src/eval/run-supplier-impact.ts --repeat 1",
    "eval:smoke": "ts-node src/eval/run.ts --repeat 1",
    "eval:diff": "ts-node src/eval/diff/diff.ts",
    "eval:history": "ts-node src/eval/diff/history.ts",
    "severity:check": "ts-node src/eval/severity/severity-selftest.ts",
    "checks:check": "ts-node src/eval/checks/checks-selftest.ts",
    "retrieval:check": "ts-node src/eval/retrieval/retrieval-selftest.ts",
    "retrieval:eval": "ts-node src/eval/retrieval/run-retrieval.ts",
    "tools:check": "ts-node src/agent/tool/tools-selftest.ts",
    "supplier:check": "ts-node src/tools/functions/supplier-impact-selftest.ts",
    "prompt:check": "ts-node src/agent/prompt/prompt-selftest.ts",
    "supplier-prompt:check": "ts-node src/agent/prompt/supplier-impact-prompt-selftest.ts",
    "ask": "ts-node src/cli/ask.ts",
    "db:drop": "ts-node src/db/init/drop.ts",
    "db:reset": "ts-node src/db/init/drop.ts --yes && ts-node src/db/init/create.ts && ts-node src/db/init/migrate.ts && ts-node src/db/seed/seed.ts && ts-node src/db/init/check.ts",
    "grounding:probe": "ts-node src/db/init/probe-grounding.ts",
    "classify:probe": "ts-node src/db/init/classify-probe.ts",
    "kb:create": "ts-node src/db/init/kb-create.ts",
    "chunks": "ts-node src/grounding/cli.ts chunks",
    "env:check": "ts-node src/grounding/cli.ts config",
    "corpus:load": "ts-node src/grounding/cli.ts corpus:load",
    "corpus:check": "ts-node src/grounding/cli.ts corpus:check",
    "ingest": "ts-node src/grounding/cli.ts ingest",
    "query": "ts-node src/grounding/cli.ts query",
    "source:probe": "ts-node src/grounding/source-probe.ts",
    "price:check": "ts-node ../../../packages/telemetry/src/price-selftest.ts",
    "history:stats": "ts-node src/cli/ask-history-stats.ts",
    "world:check": "ts-node src/db/seed/world-check.ts",
    "debate": "ts-node src/cli/lot-debate.ts",
    "fanout": "ts-node src/cli/supplier-fanout.ts",
    "fanout:check": "ts-node src/agent/loop/fanout-selftest.ts",
    "supplier-eval:fanout": "ts-node src/eval/run-supplier-impact.ts --fanout",
    "injection:check": "ts-node src/guard/injection-selftest.ts"
  },
  "dependencies": {
    "@fde/agent": "workspace:*",
    "@fde/estate": "workspace:*",
    "@fde/evals": "workspace:*",
    "@fde/foundry": "workspace:*",
    "@fde/grounding": "workspace:*",
    "@fde/scanner": "workspace:*",
    "@fde/schema": "workspace:*",
    "@fde/telemetry": "workspace:*",
    "@langchain/core": "^1.2.9",
    "@langchain/pgvector": "^0.1.0",
    "dotenv": "^16.4.5",
    "openai": "^7.10.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "main": "./dist/agent/loop/release-agent.js",
  "exports": {
    ".": "./dist/agent/loop/release-agent.js",
    "./schema": "./dist/schema/release-schema.js",
    "./config": "./dist/config/connections.js",
    "./telemetry": "./dist/telemetry/prices.js",
    "./directory": "./dist/directory.js",
    "./supplier": "./dist/agent/loop/supplier-impact-agent.js",
    "./supplier-schema": "./dist/schema/supplier-impact-schema.js",
    "./fanout": "./dist/agent/loop/supplier-impact-fanout.js",
    "./debate": "./dist/agent/loop/debate-entry.js"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3"
  },
  "files": [
    "dist",
    "db/schema",
    "package.json"
  ]
}
