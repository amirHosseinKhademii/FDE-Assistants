{
  "name": "@wrap/ai",
  "version": "0.0.1",
  "private": true,
  "description": "Wrap AI — ingestion, retrieval, agent, tools, evals.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "ingest": "echo 'not implemented yet'",
    "query": "echo 'not implemented yet'",
    "eval": "tsx src/evals/runner.ts",
    "eval:diff": "tsx src/evals/compare.ts",
    "eval:history": "tsx src/evals/history.ts",
    "eval:latest": "tsx src/evals/history.ts --latest",
    "ask": "echo 'not implemented yet'",
    "make-mess": "RNG_SEED=${RNG_SEED:-42} tsx src/cli/make-mess.ts",
    "foundation:check": "tsx src/cli/foundation-check.ts",
    "golden:check": "tsx src/cli/golden-check.ts",
    "detect:check": "tsx src/ingest/format-detector.selftest.ts",
    "dedup:check": "tsx src/ingest/dedup.selftest.ts",
    "pii:check": "tsx src/ingest/pii-scrubber.selftest.ts",
    "detect-formats": "tsx src/cli/detect-formats.ts",
    "dedup-check": "tsx src/cli/dedup-check.ts",
    "scrub-pii": "tsx src/cli/scrub-pii.ts"
  },
  "dependencies": {
    "@fde/foundry": "workspace:*",
    "@fde/guard": "workspace:*",
    "@fde/telemetry": "workspace:*",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "@types/pg": "^8.23.1",
    "typescript": "^5.1.3",
    "tsx": "^4.23.15"
  },
  "files": [
    "dist",
    "package.json"
  ]
}
