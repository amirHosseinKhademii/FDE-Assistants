{
  "name": "@bostad/ai",
  "version": "0.0.1",
  "private": true,
  "description": "Bostad 'Ask about this address' judgment layer: answer schema, profile tool, prompt, ask loop, smoke eval. Model calls via Azure Foundry.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "schema:check": "ts-node src/cli/schema-check.ts",
    "ask": "ts-node src/cli/ask.ts",
    "eval": "ts-node src/evals/run.ts",
    "eval:smoke": "ts-node src/evals/run.ts --repeat 1"
  },
  "dependencies": {
    "@bostad/property": "workspace:*",
    "@fde/agent": "workspace:*",
    "@fde/foundry": "workspace:*",
    "@fde/schema": "workspace:*",
    "@fde/telemetry": "workspace:*",
    "dotenv": "^16.4.5",
    "openai": "^7.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3"
  }
}
