# ONE COPY OF `openai`, AND THE REASON IS A TYPE ERROR THAT LOOKS LIKE NONSENSE.
#
# `openai@7` declares OPTIONAL peer dependencies on `@aws-sdk/credential-provider-node`
# and `@smithy/signature-v4` — it has its own Bedrock support. While nothing in
# the tree provided those, pnpm built one `openai`. The moment `@fde/bedrock`
# arrived and brought the AWS SDK with it, pnpm built a SECOND `openai` with the
# peers satisfied, and TypeScript correctly refused to pass a client from one
# into a function typed by the other:
#
#   Property '#private' in type 'OpenAI' refers to a different member
#   that cannot be accessed from within type 'OpenAI'
#
# Two identical versions, two identities. The same class of bug the workspace
# notes warn about for the domain package — "two loops pretending to be one".
#
# `dedupe-peer-dependents` collapses peer-variant duplicates back to one
# resolution, which is what we want: there is one Azure client in this repo and
# it should have one type.
dedupe-peer-dependents=true

# AND ONE FLAT node_modules, for the same reason.
#
# `dedupe-peer-dependents` alone did not collapse the two `openai` builds: pnpm
# considers a peer-variant a legitimately different package, and it is right to.
# `@fde/agent` saw the no-AWS build and `@vantis/steering` — once it depended on
# `@fde/bedrock` — saw the AWS one, so `runLoop(client)` stopped accepting the
# client steering had.
#
# WHAT THIS COSTS: pnpm's strict isolation, which is the thing that caught a
# missing `@anthropic-ai/sdk` declaration in `@fde/bedrock` an hour ago. Losing
# it means an undeclared import can now compile. That is a real loss and the
# trade is deliberate: one identity per library matters more here than catching
# undeclared imports, and `pnpm leak:check` plus the typecheck still run.
node-linker=hoisted
