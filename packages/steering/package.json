{
  "name": "@vantis/steering",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/config/connections.js",
  "exports": {
    "./config": "./dist/config/connections.js",
    "./ids": "./dist/config/ids.js",
    "./estate": "./dist/db/seed/estate.js",
    "./assess": "./dist/agent/loop/assess-requirement.js",
    "./requirements": "./dist/answer/requirements.js",
    "./history": "./dist/answer/filed-assessments.js",
    "./roll-up": "./dist/agent/summary/roll-up.js",
    "./summarise": "./dist/agent/loop/summarise-bid.js",
    "./schema": "./dist/schema/assessment-schema.js",
    "./explain": "./dist/agent/loop/explain-assessment.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "env:check": "ts-node src/db/init/env-check.ts",
    "corpus": "ts-node src/db/seed/write-corpus.ts",
    "estate:check": "ts-node src/db/init/estate-check.ts",
    "world:check": "ts-node src/db/seed/world-check.ts",
    "rows": "ts-node src/cli/probe.ts",
    "db:create": "ts-node src/db/init/create.ts",
    "db:migrate": "ts-node src/db/init/migrate.ts",
    "db:seed": "ts-node src/db/seed/seed.ts",
    "db:check": "ts-node src/db/init/check.ts",
    "db:drop": "ts-node src/db/init/drop.ts",
    "db:reset": "ts-node src/db/init/drop.ts --yes && ts-node src/db/init/create.ts && ts-node src/db/init/migrate.ts && ts-node src/db/seed/seed.ts && ts-node src/db/init/check.ts",
    "sabotage:check": "ts-node src/db/init/sabotage-check.ts",
    "inventory": "ts-node src/cli/inventory.ts",
    "corpus:web": "ts-node src/cli/corpus-web.ts",
    "estate:web": "ts-node src/cli/estate-web.ts",
    "walk:angle": "ts-node src/cli/walk-angle.ts",
    "walk:cost": "ts-node src/cli/walk-cost.ts",
    "walk:check": "ts-node src/answer/walk-check.ts",
    "corpus:check": "ts-node src/db/init/corpus-check.ts",
    "derived:create": "ts-node src/derived/init/create.ts",
    "derived:migrate": "ts-node src/derived/init/migrate.ts",
    "derived:parse": "ts-node src/derived/ingest/parse.ts",
    "derived:reconcile": "ts-node src/derived/grade/reconcile-cli.ts",
    "derived:boundary-check": "ts-node src/derived/init/boundary-check.ts",
    "derived:drop": "ts-node src/derived/init/drop.ts",
    "derived:extract": "ts-node src/derived/extract/run.ts",
    "derived:grade-facts": "ts-node src/derived/grade/facts-cli.ts",
    "derived:compliance-check": "ts-node src/derived/extract/compliance-check.ts",
    "sql:check": "ts-node src/guard/sql-write-selftest.ts",
    "derived:fetch-check": "ts-node src/tools/departments/derived-selftest.ts",
    "index": "ts-node src/grounding/index-cli.ts",
    "search": "ts-node src/cli/search.ts",
    "retrieval:check": "ts-node src/tools/departments/documents-selftest.ts",
    "code-chunk:check": "ts-node src/grounding/code-chunker-selftest.ts",
    "comparables:check": "ts-node src/tools/functions/comparables-selftest.ts",
    "search-tool:check": "ts-node src/agent/tool/search-tool-selftest.ts",
    "schema:check": "ts-node src/schema/assessment-selftest.ts",
    "assess": "ts-node src/cli/assess.ts",
    "summarise": "ts-node src/cli/summarise.ts",
    "summary:check": "ts-node src/agent/summary/summary-selftest.ts",
    "checks:check": "ts-node src/eval/checks/checks-selftest.ts",
    "eval": "ts-node src/eval/run.ts",
    "eval:smoke": "ts-node src/eval/run.ts --repeat 1",
    "severity:check": "ts-node src/eval/severity/severity-selftest.ts",
    "worked-example": "ts-node src/cli/worked-example.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.23.0",
    "@fde/grounding": "workspace:*",
    "@fde/foundry": "workspace:*",
    "openai": "^7.10.0",
    "@langchain/core": "^1.2.9",
    "@fde/agent": "workspace:*",
    "zod": "^4.5.4",
    "@fde/telemetry": "workspace:*",
    "@fde/schema": "workspace:*",
    "@fde/evals": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3"
  }
}
